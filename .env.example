# ── Sholab Dex Tech — environment variables ──────────────────────────────────
# Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env
#
# On Vercel, add the same keys under
# Project → Settings → Environment Variables (see DEPLOY.md).

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# A Postgres connection string. On Vercel use a Neon database — the free tier
# works and its HTTP driver is what makes the serverless function viable.
# Neon gives you two strings; use the POOLED one for the app.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Which driver the app uses to talk to Postgres.
#   tcp  — node-postgres pool. Right for a long-running server (local dev, Docker).
#   http — Neon serverless HTTP. REQUIRED on Vercel / any serverless host,
#          because a function has no process to hold a TCP pool open.
DB_DRIVER=tcp

# Max TCP connections the pool may hold. Only used when DB_DRIVER=tcp.
DB_POOL_MAX=5

# ── Auth (REQUIRED, even though accounts are off) ────────────────────────────
# The app ships with accounts disabled, but the session layer still reads this
# at startup. Any long random string works — generate one with:
#   openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-string

# none = no login, no signup, everyone sees the same content (this app).
# local = email/password accounts.  sso = platform single sign-on.
AUTH_PROVIDER=none

# ── App identity ─────────────────────────────────────────────────────────────
# Used to namespace the session cookie so two apps on one host cannot clash.
APP_SLUG=sholab-dex-tech

# ── File storage (optional) ──────────────────────────────────────────────────
# Only needed if you use the image-upload fields in the /sholab admin panel.
# Leave blank to disable uploads; you can still paste an image URL by hand.
APP_STORAGE_PRESIGN_URL=
APP_STORAGE_TOKEN=

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PORT=3001
